{
  "name": "dsh-free-search-fork-for-dsht",
  "version": "0.9.2",
  "description": "Local independent fork of dsh-free-search. Free web search for DeepSeek Harness: 24 engines (Bing/DuckDuckGo/AnySearch/SearXNG/Exa/Tavily/Keenable/Firecrawl/Parallel keyless; Zhihu global/site via MCP and Perplexity/SerpBase/DeepSeek/You.com/Baidu/Kimi/Aliyun/Doubao with key; OpenAI/Gemini/Claude model built-in search, explicit-only) + auto smart routing + global engine enable/disable & fallback priority + editable zh/en language pools + multi mode (parallel full language-pool merge) + multi_search cross-source tool + failure-aware fallback (quota/auth cooldown, transient retry, fallbackOn) + time filtering + platform search + domain blocklist (blockedDomains) + web_fetch, with web settings UI.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "check": "node scripts/check-consistency.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/mcp_adapter.js",
    "lib/research.js",
    "lib/rerank.js",
    "lib/cache.js",
    "lib/vertical.js",
    "lib/fetch_provider.js",
    "lib/fetch_upstream.js",
    "lib/weather.js",
    "lib/domain_filter.js",
    "lib/url_norm.js",
    "lib/multi_policy.js",
    "lib/search_switch.js",
    "lib/paths.js",
    "lib/proxy.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
