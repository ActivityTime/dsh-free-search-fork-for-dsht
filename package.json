{
  "name": "dsh-free-search-fork-for-dsht",
  "version": "0.9.1",
  "description": "DSHT（DeepSeek Harness Tavern）适配版 · dsh-free-search 独立 fork。免费联网搜索：24 个引擎（Bing/DuckDuckGo/AnySearch/SearXNG/Exa/Tavily/Keenable/Firecrawl/Parallel 免 key；Zhihu global/site 走 MCP；Perplexity/SerpBase/DeepSeek/You.com/Baidu/Kimi/Aliyun/Doubao 带 key；OpenAI/Gemini/Claude 模型内置搜索，仅显式调用）+ 自动智能路由 + 引擎全局启停与回退优先级 + 可编辑中英文分池 + multi 模式（并行全语言池合并）+ multi_search 跨源工具 + 失败感知回退（quota/auth 冷却、transient 重试、fallbackOn）+ 时间过滤 + 平台搜索 + 域名黑名单（blockedDomains）+ web_fetch，带联网设置页。不再追踪上游 DDDMUC/dsh-free-search。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsht",
    "dsh-tavern",
    "web-search",
    "duckduckgo",
    "bing",
    "tavily",
    "exa",
    "keenable",
    "firecrawl",
    "parallel",
    "perplexity",
    "serpbase",
    "serply",
    "search",
    "free",
    "baidu",
    "kimi",
    "moonshot",
    "aliyun",
    "youcom",
    "multi-search",
    "auto-routing",
    "doubao",
    "volcengine",
    "volcano",
    "zhihu"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "undici": "^8.12.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-commands": "^0.1.5-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.1.5-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": "^18.2.0",
    "dsh-better-sidebar": "0.19.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-plugin-manager": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.1 || ^0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1 || ^0.1.7-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible",
        "0.1.7-rc.1": "compatible"
      }
    }
  }
}
